# Image-owned budget defaults for one review.
#
# The entrypoint sources this file, then a workflow variable of the same name wins. Keeping the
# numbers here is what lets a change reach every consumer through `:latest` instead of a workflow
# edit in each repository; a workflow sets one only to override it.
: "${GOBY_MAX_ROUNDS:=1}"
# pi's own default is `medium`. A review is the one product where the model is reasoning about a
# diff nobody has read yet, so the level is stated here rather than inherited: on the same prompt,
# `medium` produced 554 reasoning tokens and `high` 1033 (measured against the gateway when `max`
# was opened), and that difference is the review's judgement, not its overhead.
: "${GOBY_THINKING:=high}"
: "${GOBY_MAX_TURNS:=50}"
: "${GOBY_MAX_TOOL_CALLS:=80}"
# The agent's own wall clock, in seconds — the bound a turn cap cannot supply. A turn cap is not a
# clock: 50 turns at a slow provider's latency took 14.5 minutes, the runner killed the job at its
# `timeout-minutes` before the review reached a verdict, and the statuses `prepare` had posted stayed
# pending. So this number sits well inside the shipped workflow's 15 minutes, leaving the clone, the
# diff and the publish their time.
: "${GOBY_AGENT_TIMEOUT_S:=600}"
: "${GOBY_BASH_TIMEOUT_S:=120}"
: "${GOBY_MAX_DIFF_LINES:=50000}"
# Past this many diff lines the brief names `out/diff.patch` instead of inlining it. Inlining
# a 4,000-line diff is a long prompt; inlining an 18,000-line one is 195k tokens re-sent on
# every turn, and the reviewer reaches its context limit before the end of the change.
: "${GOBY_INLINE_DIFF_LINES:=4000}"
: "${GOBY_MAX_FINDINGS:=30}"
# Verification re-runs the reviewer's own reproduction against the head and the merge base.
# `off` is the old behaviour; `advisory` still posts what it could not reproduce and says so;
# `required` publishes only reproduced findings and lets the gate refuse a high-severity claim
# nobody could reproduce. The karucode test deployment runs `required`.
: "${GOBY_VERIFY:=advisory}"
# Bounds for that pass: how many findings are probed, one probe's clock, and the whole pass.
: "${GOBY_MAX_PROBES:=8}"
: "${GOBY_PROBE_TIMEOUT_S:=90}"
: "${GOBY_VERIFY_BUDGET_S:=300}"
export GOBY_MAX_ROUNDS GOBY_MAX_TURNS GOBY_MAX_TOOL_CALLS GOBY_AGENT_TIMEOUT_S GOBY_BASH_TIMEOUT_S
# The thinking level is exported with the budgets it changes the cost of.
export GOBY_THINKING
export GOBY_MAX_DIFF_LINES GOBY_MAX_FINDINGS GOBY_INLINE_DIFF_LINES
export GOBY_VERIFY GOBY_MAX_PROBES GOBY_PROBE_TIMEOUT_S GOBY_VERIFY_BUDGET_S
